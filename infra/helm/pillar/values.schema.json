{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["deploymentMode", "environment"],
  "properties": {
    "deploymentMode": {"enum": ["hosted", "customer-validator", "self-hosted"]},
    "environment": {"enum": ["dev", "testnet", "mainnet", "sandbox"]},
    "image": {"type": "object"},
    "registry": {"type":"object","properties":{"uploadPlanId":{"type":"string","minLength":1}}},
    "templateRegistry": {"type":"object","required":["image","signing"],"properties":{"replicas":{"type":"integer","minimum":1},"image":{"type":"object","required":["repository","tag"],"properties":{"repository":{"type":"string"},"tag":{"type":"string"},"digest":{"type":"string"}}},"signing":{"type":"object","required":["trustedKeyIds"],"properties":{"trustedKeyIds":{"type":"array","items":{"type":"string","minLength":1}},"trustRoots":{"type":"array","items":{"type":"string"}}}}}}
  },
  "$defs": {"digestedService": {"type": "object", "required": ["image"], "properties": {"image": {"type": "object", "required": ["repository", "digest"], "properties": {"repository": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}}}
}
