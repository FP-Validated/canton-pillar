# ledger-command runtime mode
PILLAR_LEDGER_SUBMITTER=grpc
PILLAR_DEPLOYMENT_MODE=dev

# Canton Ledger API endpoint
PILLAR_LEDGER_HOST=localhost
PILLAR_LEDGER_PORT=6865
PILLAR_LEDGER_TLS=false

# Ledger API auth; set the token directly or point your launcher at a secret file.
PILLAR_LEDGER_JWT=
# PILLAR_LEDGER_JWT_PATH=/run/secrets/pillar-ledger-jwt

# Party and application identity used for command submission.
PILLAR_LEDGER_ACT_AS=
PILLAR_LEDGER_APPLICATION_ID=pillar-runtime
