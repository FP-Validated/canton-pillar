{
  "title": "Dr Security",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "pillar_dr_failover_seconds",
      "targets": [
        {
          "expr": "pillar_dr_failover_seconds{network=~\"$network\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pillar-prometheus"
          }
        }
      ]
    }
  ],
  "uid": "pillar-dr-security",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pillar-prometheus"
        },
        "query": "label_values(up, network)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
