-- Pillar Test :: OverHoldNegativeScript. Ticket B06.
module Pillar.Test.OverHoldNegativeScript where

import Daml.Script
import Pillar.Assets.Holding
import Pillar.Test.Fixtures

overHoldNegativeTest : Script ()
overHoldNegativeTest = do
  parties <- setupParties
  now <- getTime
  holdingCid <- createHolding parties.operator parties.issuer parties.alice aliceHoldingRef 10.0 now
  submitMustFail parties.operator do
    exerciseCmd holdingCid CreateHold with holdMeta = mkMeta "over_hold" testTenantId now; holdAmount = 11.0; purpose = "transfer"; expiresAt = None; newVersionTag = "v2"
  pure ()
