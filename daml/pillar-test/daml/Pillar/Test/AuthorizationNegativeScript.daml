-- Pillar Test :: AuthorizationNegativeScript. Ticket B06.
module Pillar.Test.AuthorizationNegativeScript where

import Daml.Script
import Pillar.Core.TenantConfig
import Pillar.Core.Meta (emptyMetadata)
import Pillar.Test.Fixtures

nonOperatorCannotExerciseConfirmIssue : Script ()
nonOperatorCannotExerciseConfirmIssue = do
  parties <- setupParties
  now <- getTime
  tenantCid <- submit parties.operator do
    createCmd TenantConfig with
      operator = parties.operator
      issuer = parties.issuer
      meta = mkMeta "tenant_config_auth_issue" testTenantId now
      defaultApiVersion = "2026-05-26"
      pinnedSchema = None
  submitMustFail parties.alice do
    exerciseCmd tenantCid (UpdateTenantConfig with newApiVersion = "2026-05-26"; newPinnedSchema = None; newMetadata = emptyMetadata; now = now)

nonIssuerCannotChangeAssetRules : Script ()
nonIssuerCannotChangeAssetRules = do
  parties <- setupParties
  now <- getTime
  tenantCid <- submit parties.operator do
    createCmd TenantConfig with
      operator = parties.operator
      issuer = parties.issuer
      meta = mkMeta "tenant_config_auth_asset" testTenantId now
      defaultApiVersion = "2026-05-26"
      pinnedSchema = None
  submitMustFail parties.alice do
    exerciseCmd tenantCid ArchiveTenantConfig

nonHolderCannotTransferOwnership : Script ()
nonHolderCannotTransferOwnership = do
  parties <- setupParties
  now <- getTime
  tenantCid <- submit parties.operator do
    createCmd TenantConfig with
      operator = parties.operator
      issuer = parties.issuer
      meta = mkMeta "tenant_config_auth_holding" testTenantId now
      defaultApiVersion = "2026-05-26"
      pinnedSchema = None
  submitMustFail parties.bob do
    exerciseCmd tenantCid ArchiveTenantConfig
