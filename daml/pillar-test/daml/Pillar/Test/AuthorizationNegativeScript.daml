-- Pillar Test :: AuthorizationNegativeScript. Ticket B06.
module Pillar.Test.AuthorizationNegativeScript where

import Daml.Script
import Pillar.Assets.Holding
import Pillar.Test.Fixtures

authorizationNegativeTest : Script ()
authorizationNegativeTest = do
  parties <- setupParties
  now <- getTime
  holdingCid <- createHolding parties.operator parties.issuer parties.alice aliceHoldingRef 100.0 now
  submitMustFail parties.bob do
    exerciseCmd holdingCid CreateHold with holdMeta = mkMeta "unauthorized_hold" testTenantId now; holdAmount = 10.0; purpose = "transfer"; expiresAt = None; newVersionTag = "v2"
  pure ()
