-- Pillar Test :: Fixtures. Ticket B06.
module Pillar.Test.Fixtures where

import Daml.Script
import Pillar.Assets.AssetRules (AssetRules(..))
import Pillar.Assets.Holding
import Pillar.Core.AccountRef
import Pillar.Core.Meta
import Pillar.Core.Types
import Pillar.Intents.Common
import Pillar.Ops.OperationTrace

data TestParties = TestParties with
  operator : Party
  issuer   : Party
  alice    : Party
  bob      : Party

setupParties : Script TestParties
setupParties = do
  op <- allocateParty "operator"
  iss <- allocateParty "issuer"
  a <- allocateParty "alice"
  b <- allocateParty "bob"
  pure (TestParties op iss a b)

mkMeta : Text -> Text -> Time -> PillarMeta
mkMeta oid tid now = PillarMeta with
  objectId = oid
  tenantId = tid
  apiVersion = "2026-05-26"
  schemaVersion = 1
  livemode = False
  requestId = None
  idempotencyKey = None
  workflowId = None
  createdAt = now
  updatedAt = now
  metadata = emptyMetadata

testTenantId : Text
testTenantId = "tenant_test"

testAssetRef : AssetRef
testAssetRef = AssetRef with tenantId = testTenantId; assetId = "asst_test_usd"

aliceAccount : AccountRef
aliceAccount = AccountRef with tenantId = testTenantId; accountId = "acct_alice"

bobAccount : AccountRef
bobAccount = AccountRef with tenantId = testTenantId; accountId = "acct_bob"

otherTenantAccount : AccountRef
otherTenantAccount = AccountRef with tenantId = "tenant_other"; accountId = "acct_other"

aliceHoldingRef : HoldingRef
aliceHoldingRef = HoldingRef with account = aliceAccount; asset = testAssetRef

bobHoldingRef : HoldingRef
bobHoldingRef = HoldingRef with account = bobAccount; asset = testAssetRef

otherTenantHoldingRef : HoldingRef
otherTenantHoldingRef = HoldingRef with account = otherTenantAccount; asset = AssetRef with tenantId = "tenant_other"; assetId = "asst_test_usd"

mkBase : Party -> Text -> Time -> IntentBase
mkBase operator objectId now = IntentBase with
  meta = mkMeta objectId testTenantId now
  status = RequiresAction
  initiator = operator
  failureReason = None

mkHolding : Party -> Party -> Party -> HoldingRef -> Decimal -> Time -> Holding
mkHolding operator issuer holder ref amount now = Holding with
  operator
  issuer
  holder
  meta = mkMeta ("h_" <> ref.account.accountId) ref.account.tenantId now
  holdingRef = ref
  owner = holder
  amount
  activeHolds = 0.0
  versionTag = "v1"

createHolding : Party -> Party -> Party -> HoldingRef -> Decimal -> Time -> Script (ContractId Holding)
createHolding operator issuer holder ref amount now =
  submit (actAs [operator, issuer, holder]) do createCmd (mkHolding operator issuer holder ref amount now)

createRules : Party -> Party -> Party -> AssetStatus -> Bool -> Time -> Script (ContractId AssetRules)
createRules operator issuer tenantOperator status transferEnabled now =
  submit (actAs [operator, issuer]) do
    createCmd AssetRules with
      operator
      issuer
      tenantOperator
      meta = mkMeta "rules" testTenantId now
      assetRef = testAssetRef
      status
      precision = 2
      transferEnabled
      redemptionEnabled = True
      mintEnabled = True
      restrictions = []
      versionTag = "v1"

createTrace : Party -> IntentKind -> Text -> Time -> Script (ContractId OperationTrace)
createTrace operator kind objectId now =
  submit operator do
    createCmd OperationTrace with
      operator
      meta = mkMeta ("trace_" <> objectId) testTenantId now
      status = OpReceived
      intentKind = kind
      intentObjectId = objectId
      commandId = None
      submissionId = None
      updateId = None
      ledgerOffset = None
      ledgerTime = None
      traceId = "tr_" <> objectId
      failureReason = None
      retryCount = 0

assertTrue : Text -> Bool -> Script ()
assertTrue label condition = assertMsg label condition

assertEq : (Eq a, Show a) => Text -> a -> a -> Script ()
assertEq label expected actual = assertMsg (label <> ": expected " <> show expected <> ", got " <> show actual) (expected == actual)

expectSome : Text -> Optional a -> Script a
expectSome label value = case value of
  None -> abort label
  Some x -> pure x

assertArchived : (Template t, HasEnsure t) => Party -> Text -> ContractId t -> Script ()
assertArchived party label cid = do
  found <- queryContractId party cid
  case found of
    None -> pure ()
    Some _ -> abort label

assertSupportedSchemaVersion : Text -> Int -> [Int] -> Script ()
assertSupportedSchemaVersion label version supported = assertMsg label (elem version supported)
