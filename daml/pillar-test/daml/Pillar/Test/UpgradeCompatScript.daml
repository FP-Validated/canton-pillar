-- Pillar Test :: UpgradeCompatScript. Ticket B26.
module Pillar.Test.UpgradeCompatScript where

import Daml.Script
import Pillar.Assets.Versioning
import Pillar.Test.Fixtures

upgradeCompatTest : Script ()
upgradeCompatTest = do
  assertEq "current schema accepted" (Right ()) (requireSupportedSchema currentSchemaVersion)
  assertEq "schema 0 rejected" (Left "unsupported asset schema version") (requireSupportedSchema 0)
  assertEq "schema 99 rejected" (Left "unsupported asset schema version") (requireSupportedSchema 99)
  pure ()
