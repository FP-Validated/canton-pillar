-- Pillar Test :: InvalidTransferNegativeScript. Ticket B06.
module Pillar.Test.InvalidTransferNegativeScript where

import Daml.Script
import Pillar.Assets.Holding
import Pillar.Core.Types
import Pillar.Intents.TransferIntent
import Pillar.Test.Fixtures

mkTransferIntent : TestParties -> Text -> Time -> TransferIntent
mkTransferIntent parties objectId now = TransferIntent with
  operator = parties.operator
  issuer = parties.issuer
  base = mkBase parties.operator objectId now
  fromAccountId = aliceAccount.accountId
  toAccountId = bobAccount.accountId
  assetId = testAssetRef.assetId
  amount = 25.0
  expiresAt = None

transferAcrossTenantsFails : Script ()
transferAcrossTenantsFails = do
  parties <- setupParties
  now <- getTime
  rulesCid <- createRules parties.operator parties.issuer parties.operator AssetActive True now
  fromCid <- createHolding parties.operator parties.issuer parties.alice aliceHoldingRef 100.0 now
  toCid <- createHolding parties.operator parties.issuer parties.bob otherTenantHoldingRef 10.0 now
  (holdCid, heldFromCid) <- submit parties.operator do
    exerciseCmd fromCid CreateHold with holdMeta = mkMeta "tenant_hold" testTenantId now; holdAmount = 25.0; purpose = "transfer"; expiresAt = None; newVersionTag = "v2"
  traceCid <- createTrace parties.operator KindTransfer "tenant_fail" now
  intentCid <- submit (actAs [parties.operator, parties.issuer]) do createCmd (mkTransferIntent parties "tenant_fail" now)
  submitMustFail parties.operator do
    exerciseCmd intentCid ConfirmTransfer with now; fromHoldingCid = heldFromCid; toHoldingCid = toCid; holdCid; assetRulesCid = rulesCid; sourceMeta = mkMeta "from_after" testTenantId now; destinationMeta = mkMeta "to_after" testTenantId now; sourceVersionTag = "v3"; destinationVersionTag = "v2"; operationTraceId = traceCid; submissionId = "sub"
  pure ()

transferWithSuspendedAssetFails : Script ()
transferWithSuspendedAssetFails = do
  parties <- setupParties
  now <- getTime
  rulesCid <- createRules parties.operator parties.issuer parties.operator AssetSuspended True now
  fromCid <- createHolding parties.operator parties.issuer parties.alice aliceHoldingRef 100.0 now
  toCid <- createHolding parties.operator parties.issuer parties.bob bobHoldingRef 10.0 now
  (holdCid, heldFromCid) <- submit parties.operator do
    exerciseCmd fromCid CreateHold with holdMeta = mkMeta "suspended_hold" testTenantId now; holdAmount = 25.0; purpose = "transfer"; expiresAt = None; newVersionTag = "v2"
  traceCid <- createTrace parties.operator KindTransfer "suspended_fail" now
  intentCid <- submit (actAs [parties.operator, parties.issuer]) do createCmd (mkTransferIntent parties "suspended_fail" now)
  submitMustFail parties.operator do
    exerciseCmd intentCid ConfirmTransfer with now; fromHoldingCid = heldFromCid; toHoldingCid = toCid; holdCid; assetRulesCid = rulesCid; sourceMeta = mkMeta "from_after" testTenantId now; destinationMeta = mkMeta "to_after" testTenantId now; sourceVersionTag = "v3"; destinationVersionTag = "v2"; operationTraceId = traceCid; submissionId = "sub"
  pure ()
