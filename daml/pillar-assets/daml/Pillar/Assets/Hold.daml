-- Pillar Assets :: Hold. Ticket B13.
module Pillar.Assets.Hold where

import Pillar.Core.AccountRef (HoldingRef)
import Pillar.Core.Meta (PillarMeta)
import Pillar.Core.Types (HoldStatus(..))

template Hold
  with
    operator : Party
    issuer : Party
    ownerHolder : Party
    meta : PillarMeta
    holdingRef : HoldingRef
    amount : Decimal
    status : HoldStatus
    purpose : Text
    expiresAt : Optional Time
  where
    signatory operator, issuer
    observer ownerHolder
    ensure amount > 0.0 && status == HoldActive
