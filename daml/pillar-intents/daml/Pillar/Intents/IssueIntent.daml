-- Pillar Intents :: IssueIntent. Ticket B03/B16.
module Pillar.Intents.IssueIntent where

import Pillar.Core.Types
import Pillar.Intents.Common

template IssueIntent
  with
    operator : Party
    issuer : Party
    base : IntentBase
    accountId : Text
    assetId : Text
    amount : Amount
    expiresAt : Optional Time
  where
    signatory operator, issuer
    observer operator
    ensure amount > 0.0 && base.meta.objectId /= "" && accountId /= "" && assetId /= "" && base.initiator == operator

    choice ConfirmIssue : ContractId IssueIntent
      with
        now : Time
      controller operator
      do
        assertMsg "IssueIntent must be RequiresAction to confirm" (ensureRequiresAction base)
        create this with base = markProcessing base now

    choice CancelIssue : ContractId IssueIntent
      with
        now : Time
      controller operator
      do
        create this with base = markCanceled base now

    choice FailIssue : ContractId IssueIntent
      with
        reason : Text
        now : Time
      controller operator
      do
        assertMsg "failure reason is required" (reason /= "")
        create this with base = markFailed base reason now

    choice MarkIssueSucceeded : ContractId IssueIntent
      with
        now : Time
      controller operator
      do
        assertMsg "IssueIntent must be Processing to succeed" (ensureProcessing base)
        create this with base = markSucceeded base now

    choice ExpireIssue : ContractId IssueIntent
      with
        now : Time
      controller operator
      do
        assertMsg "IssueIntent must be Processing to expire" (ensureProcessing base)
        case expiresAt of
          None -> abort "IssueIntent has no expiry deadline"
          Some deadline -> assertMsg "IssueIntent expiry deadline has not passed" (now >= deadline)
        create this with base = markExpired base now
