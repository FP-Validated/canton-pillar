# Pillar local-development environment example.
# Copy to .env (gitignored). NEVER commit real credentials.
# Production values come from External Secrets / KMS per docs/Dev/Phase_08_Security_Compliance.md.

# Database (local sandbox only)
DATABASE_URL=postgres://pillar:pillar@localhost:5432/pillar
PILLAR_DATABASE_URL=postgres://pillar:pillar@localhost:5432/pillar

# Redis
REDIS_URL=redis://localhost:6379

# Pillar API
PILLAR_BASE_URL=http://localhost:8080
PILLAR_API_VERSION_DEFAULT=2026-05-26
PILLAR_DEPLOYMENT_MODE=hosted
PILLAR_LOG_LEVEL=info

# OpenTelemetry
PILLAR_OTEL_ENDPOINT=http://localhost:4317

# Canton ledger (sandbox)
PILLAR_LEDGER_API_HOST=localhost
PILLAR_LEDGER_API_PORT=6865
# JWT for the sandbox is unset in Phase 0; sandbox accepts unauthenticated requests for local dev.
PILLAR_LEDGER_JWT_TOKEN=

# Webhook receiver (local capture only)
WEBHOOK_RECEIVER_URL=http://localhost:9090
